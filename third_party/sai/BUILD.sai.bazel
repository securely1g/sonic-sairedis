load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

API_HEADERS = glob(
    [
        "inc/*.h",
        "experimental/*.h",
        "custom/*.h",
    ],
    allow_empty = True,
)

META_HEADERS = glob(["meta/*.h"])

cc_library(
    name = "headers",
    hdrs = API_HEADERS + META_HEADERS,
    includes = [
        "custom",
        "experimental",
        "inc",
        "meta",
    ],
)

filegroup(
    name = "api_header_files",
    srcs = API_HEADERS,
)

filegroup(
    name = "metadata_header_files",
    srcs = META_HEADERS,
)

filegroup(
    name = "generator_inputs",
    srcs = API_HEADERS + META_HEADERS + glob([
        "meta/*.pm",
        "meta/*.pl",
        "meta/*.cap",
        "meta/Doxyfile*",
    ]) + [
        "meta/acronyms.txt",
        "meta/aspell.en.pws",
    ],
)

filegroup(
    name = "stub_inputs",
    srcs = API_HEADERS,
)

filegroup(
    name = "metadata_support_sources",
    srcs = [
        "meta/saimetadatautils.c",
        "meta/saiserialize.c",
    ],
)

exports_files([
    "inc/sai.h",
    "meta/parse.pl",
    "meta/saiattrversion.h",
    "LICENSE.txt",
])
