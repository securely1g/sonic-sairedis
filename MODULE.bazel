# Keep bazel_compatibility in sync with sonic-buildimage's .bazelversion.
module(
    name = "sonic-sairedis",
    version = "0.0.2",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

bazel_dep(name = "bazel_lib", version = "3.1.1")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "googletest", version = "1.16.0", repo_name = "com_google_googletest")
bazel_dep(name = "libnl3", version = "3.7.0.sonic.5")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.13")
bazel_dep(name = "rules_perl", version = "1.1.2")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

bazel_dep(name = "rules_rs", version = "0.1.0", dev_dependency = True)

bazel_dep(name = "swig", version = "4.3.0.bcr.2")
bazel_dep(name = "tar.bzl", version = "0.10.5-sonic.1")
bazel_dep(name = "sonic-build-infra", version = "0.0.21-28a3aa9b96f1ce66e4ce04f9a7d26c96e3bbb0c6", repo_name = "sonic_build_infra")
bazel_dep(name = "sonic-swss-common", version = "0.0.4-df21cc179b204f1ecdddc7fb5b06bb4e530bcd91", repo_name = "sonic_swss_common")
bazel_dep(name = "sai", version = "1.18.0-sonic.1", repo_name = "sai_source")

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

# Native libraries and headers use the shared, pinned Trixie dependency set.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "trixie",
    packages = [
        "zlib1g",
        "zlib1g-dev",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "trixie")

# Common also exports Rust bindings. This standalone C/C++ consumer does not
# build them, but the rules_rs facade needs an explicit root toolchain policy.
rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(versions = [])

# Keep SONiC's reproducible TAR timestamps selected over upstream's stable
# version, which sorts after the historical patched prerelease name.
single_version_override(
    module_name = "tar.bzl",
    version = "0.10.5-sonic.1",
)

# Distroless uses rules_cc's private cc_import implementation; 0.2.21+ needs
# a C++ runtime toolchain type introduced after this workspace's Bazel 8.5.1.
single_version_override(
    module_name = "rules_cc",
    version = "0.2.20",
)
