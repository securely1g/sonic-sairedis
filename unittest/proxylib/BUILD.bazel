load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("//bazel:common.bzl", "CODE_COVERAGE_LINKOPTS", "GTEST_DEPS", "TEST_COPTS", "working_directory_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "source_files",
    srcs = glob([
        "*.cpp",
        "*.h",
        "*.am",
        "*.json",
        "*.ini",
        "files/**",
    ]),
)

cc_binary(
    name = "tests_binary",
    testonly = True,
    srcs = [
        "TestProxy.cpp",
        "TestSai.cpp",
        "main.cpp",
    ] + glob(["*.h"]),
    copts = TEST_COPTS,
    includes = ["."],
    linkopts = ["-pthread"] + CODE_COVERAGE_LINKOPTS,
    tags = ["manual"],
    deps = [
        # Give Proxy's bare header names precedence over the Redis headers.
        "//proxylib:headers",
        "//lib:sairedis.a",
        "//meta:saimeta_shared",
        "//proxylib:saiproxy.a",
        "//syncd:libsyncd",
        "@sonic_swss_common//:libswsscommon_shared",
    ] + GTEST_DEPS,
)

working_directory_test(
    name = "tests",
    data = glob([
        "*.json",
        "*.ini",
        "files/**",
    ]),
    program = ":tests_binary",
    tags = ["exclusive"],
    working_directory = "unittest/proxylib",
)
