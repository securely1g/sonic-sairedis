load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("//bazel:common.bzl", "CODE_COVERAGE_LINKOPTS", "GTEST_DEPS", "TEST_COPTS", "working_directory_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "source_files",
    srcs = glob([
        "*.cpp",
        "*.h",
        "*.am",
        "brcm/*",
        "mlnx/*",
        "nvda-bf/*",
    ]),
)

cc_binary(
    name = "tests_binary",
    testonly = True,
    srcs = [
        "TestDisabledRedisClient.cpp",
        "TestSyncdBrcm.cpp",
        "TestSyncdLib.cpp",
        "TestSyncdLinkEventDamping.cpp",
        "TestSyncdMlnx.cpp",
        "TestSyncdNvdaBf.cpp",
        "TestZmqRedisClient.cpp",
        "main.cpp",
    ] + glob(["*.h"]),
    copts = TEST_COPTS,
    includes = ["."],
    linkopts = ["-pthread"] + CODE_COVERAGE_LINKOPTS,
    tags = ["manual"],
    deps = [
        "//lib:sairedis.a",
        "//meta:saimeta_shared",
        "//syncd:libsyncd",
        "//syncd:libsyncd_request_shutdown",
        "//vslib:saivs_shared",
        "@sonic_swss_common//:libswsscommon_shared",
    ] + GTEST_DEPS,
)

working_directory_test(
    name = "tests",
    data = glob([
        "brcm/*",
        "mlnx/*",
        "nvda-bf/*",
    ]),
    program = ":tests_binary",
    tags = [
        "exclusive",
        "manual",
        "requires-redis",
        "requires-root",
    ],
    working_directory = "syncd/tests",
)
